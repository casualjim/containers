FROM devenv AS devenv-omp

ENV DEBIAN_FRONTEND=noninteractive \
  HOME=/home/eng \
  XDG_RUNTIME_DIR=/run/user/1000 \
  DOCKER_HOST=unix:///run/user/1000/podman/podman.sock \
  DOCKER_BUILDKIT=0

USER root

# policy-rc.d stops runit's postinst from starting runsvdir during the build
RUN set -eux; \
  printf '%s\n' '#!/bin/sh' 'exit 101' > /usr/sbin/policy-rc.d; \
  chmod 755 /usr/sbin/policy-rc.d; \
  apt-get update && apt-get install -y --no-install-recommends podman runit uidmap passt slirp4netns fuse-overlayfs netavark aardvark-dns crun catatonit nftables curl ca-certificates gnupg; \
  install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}") stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
  apt-get update && \
  apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin; \
  grep -q '^eng:' /etc/subuid || echo 'eng:100000:65536' >> /etc/subuid; \
  grep -q '^eng:' /etc/subgid || echo 'eng:100000:65536' >> /etc/subgid; \
  mkdir -p /run/user/1000 && chown eng:eng /run/user/1000; \
  rm -f /usr/sbin/policy-rc.d; \
  rm -rf /var/lib/apt/lists/*

# runit supervises the rootless podman API socket; the entrypoint starts the
# service tree and waits for that socket before handing over to the container
# command. supervise/ must belong to eng: runsv writes its control files there.
COPY devagent-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY runit/podman/ /etc/sv/podman/

RUN set -eux; \
  mkdir -p /etc/service /var/log/podman /etc/sv/podman/supervise /etc/sv/podman/log/supervise; \
  chmod -R 755 /usr/local/bin/docker-entrypoint.sh /etc/sv/podman; \
  chown -R eng:eng /var/log/podman /etc/sv/podman/supervise /etc/sv/podman/log/supervise; \
  ln -s /etc/sv/podman /etc/service/podman

USER eng

# Install omp via the documented installer (omp.sh/install.sh), then the agent
# toolchain via mise. Installer drops omp in ~/.local/bin (zshrc PATHs it).
RUN set -eux; \
  curl -fsSL https://omp.sh/install.sh | sh; \
  mkdir -p /home/eng/.config/mise && printf '%s\n' \
  '[settings]' \
  'idiomatic_version_file_enable_tools = ["pnpm","bun", "npm", "rust", "go", "uv"]' \
  '[env]' \
  '_.path = ["{{config_root}}/node_modules/.bin"]' \
  '[tools]' \
  'ripgrep = "latest"' \
  'ast-grep = "latest"' \
  'jujutsu = "latest"' \
  'fd = "latest"' \
  'fzf = "latest"' \
  'github-cli = "latest"' \
  'node = "lts"' \
  'pnpm = "latest"' \
  'bun = "latest"' \
  'fnox = "latest"' \
  '"npm:@deepseek-ai/dsh" = "0.1.5-rc.1"' \
  '"npm:@earendil-works/pi-coding-agent" = "latest"' \
  > /home/eng/.config/mise/config.toml; \
  mise trust -a && mise install &&\
  echo 'eval "$(mise activate zsh)"' >> .zshrc 

# catatonit is PID 1: it reaps strays and forwards signals; the entrypoint
# starts the runit service tree and then execs the container command.
ENTRYPOINT ["/usr/bin/catatonit", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["/bin/zsh"]



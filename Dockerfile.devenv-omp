FROM devenv AS devenv-omp

ENV DEBIAN_FRONTEND=noninteractive \
  HOME=/home/eng \
  XDG_RUNTIME_DIR=/run/user/1000 \
  DOCKER_HOST=unix:///run/user/1000/podman/podman.sock \
  DOCKER_BUILDKIT=0

USER root

RUN set -eux; \
  apt-get update && apt-get install -y --no-install-recommends podman uidmap passt slirp4netns fuse-overlayfs netavark aardvark-dns crun catatonit nftables curl ca-certificates gnupg; \
  install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}") stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
  apt-get update && \
  apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin; \
  grep -q '^eng:' /etc/subuid || echo 'eng:100000:65536' >> /etc/subuid; \
  grep -q '^eng:' /etc/subgid || echo 'eng:100000:65536' >> /etc/subgid; \
  mkdir -p /run/user/1000 && chown eng:eng /run/user/1000; \
  rm -rf /var/lib/apt/lists/*

USER eng

# Install omp via the documented installer (omp.sh/install.sh), then the agent
# toolchain via mise. Installer drops omp in ~/.local/bin (zshrc PATHs it).
RUN set -eux; \
  curl -fsSL https://omp.sh/install.sh | sh; \
  mkdir -p /home/eng/.config/mise && printf '%s\n' \
  '[settings]' \
  'idiomatic_version_file_enable_tools = ["pnpm","bun", "npm"]' \
  '[env]' \
  '_.path = ["{{config_root}}/node_modules/.bin"]' \
  '[tools]' \
  'ripgrep = "latest"' \
  'ast-grep = "latest"' \
  'jujutsu = "latest"' \
  'fd = "latest"' \
  'fzf = "latest"' \
  'github-cli = "latest"' \
  'node = "lts"' \
  'pnpm = "latest"' \
  'bun = "latest"' \
  '"npm:@deepseek-ai/dsh" = "0.1.5-rc.1"' \
  '"npm:@earendil-works/pi-coding-agent" = "latest"' \
  > /home/eng/.config/mise/config.toml; \
  mise trust -a && mise install &&\
  echo 'eval "$(mise activate zsh)"' >> .zshrc 

RUN set -eux; \
  echo 'mkdir -p "$XDG_RUNTIME_DIR"' >> .zshrc; \
  echo 'if ! [ -e "$XDG_RUNTIME_DIR/podman/podman.sock" ]; then podman system service -t 0 >/dev/null 2>&1 & fi' >> .zshrc; \
  echo 'n=0; while [ $n -lt 50 ] && ! [ -S "$XDG_RUNTIME_DIR/podman/podman.sock" ]; do sleep 0.1; n=$((n+1)); done' >> .zshrc


